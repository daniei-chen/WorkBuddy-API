# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin
/login.exe
/credit.exe
/wb2api.exe
/signin_bin.exe

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# 运行时产物（API Key / 进程号 / 日志 / 工具草稿目录）
# 为什么显式列 .apikey：它不是 config.json 的别名，而是 login.sh 等工具单独落盘的密钥文件，
# 不写进这里会被 git add -A 直接提交（含明文 api_key）。
.apikey
.server.pid
wb2api.pid
*.log
draft_*_folder/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md
!manager/README.en.md
!manager/CHANGELOG.md

# 本地构建产物
wb2api-linux

# ---- privacy additions for backup repo (2026-09-25) ----
config.json.bak*
local-patches/backup/
.local-config/

# 本地覆盖与陈旧备份（保留在服务器磁盘，不入库）
docker-compose.override.yml
*.bak-*

# Manager 运行时与本地备份（不入库）
manager/venv/
manager/local-patches/backup/
manager/**/*.log

# 环境变量模板要入库（.env 本体仍然忽略）
!.env.example

# WorkBuddy private runtime and generated artifacts
/auths/
/data/
/config.json
/.env
/.env.*
/manager/data/
/manager/.local-config
/manager/venv/
/manager/web/node_modules/
/manager/web/.next/
/image.tar
/validation-results/
*.cms
*.db
*.db-wal
*.db-shm
*private.pem

/manager/dev/.dash-groups/
/manager/dev/.shots-*/
/manager/dev/.palette/
/manager/dev/.update-clear/
# Public sanitized Manager release and audit evidence; required by CI.
!manager/docs/
!manager/docs/**
