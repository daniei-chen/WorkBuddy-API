+// pickNextLocked 顺序轮转取下一个账号（本地定制，替换原 FNV 哈希取模）：
+// 在**已排序**的候选列表 uids 中，取「轮转游标 rotLast 之后」的第一个；游标不在
+// 列表（账号失效/被移出）或未初始化时，二分插入点即为"其后"位置；到列表尾回绕
+// 到开头。列表用 sort.SearchStrings 做二分，无需重排序。
+//
+// 为什么用「上一个 uid + 二分」而不是「下标+1」：可用列表随账号冷却/额度耗尽/
+// 恢复动态伸缩，下标会在列表变化后指向错位甚至越界；记住"上一个是谁"，二分找到
+// 它在有序列表中的位置再取下一个，列表怎么变都能精确顺延，也天然跳过被过滤掉的
+// 账号（不跳漏、不重放）。调用方必须已持有 r.mu 写锁。
+func (r *Router) pickNextLocked(uids []string) string {
+	sort.Strings(uids) // 稳定序：池侧输出已排序，此处防御性再排（幂等、开销可忽略）
+	if r.rotLast == "" {
+		return uids[0] // 首次分配：从第一个开始
+	}
+	// 找 rotLast 之后第一个 > rotLast 的账号（轮转语义：不重复分配上一个）。
+	i := sort.SearchStrings(uids, r.rotLast)
+	for i < len(uids) && uids[i] <= r.rotLast {
+		i++
+	}
+	if i >= len(uids) {
+		return uids[0] // 到列表尾：回绕到开头
+	}
+	return uids[i]
+}
